# =============================================================================
# CONFIGURAÇÃO ÚNICA — edite só: backend/.env
# O mesmo arquivo roda no localhost e vai no publish para o servidor (.env).
# =============================================================================

# Porta do servidor
PORT=3000

# JWT Secret (mude em produção!)
JWT_SECRET=seu_secret_key_super_seguro_aqui_mude_em_producao

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Provedor de IA (gemini ou openai)
AI_PROVIDER=gemini

# Gemini (recomendado - gratuito)
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash
# Opcional: modelos de fallback se o principal retornar 503/429
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# OpenAI (opcional - fallback)
OPENAI_API_KEY=sk-sua-chave-openai-aqui
OPENAI_MODEL=gpt-4

# Modo Mock da IA (somente Development; em Production é sempre desligado)
USE_MOCK_AI=false

# Email/SMTP
SMTP_HOST=seu-servidor-smtp.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_SENDER=seu-email@exemplo.com
EMAIL_SENDER_PASSWORD=sua-senha-aqui
EMAIL_SENDER_NAME=CurriculosPro IA
EMAIL_COPY_TO=email-copia@exemplo.com

# Frontend URL (para links de verificação de email e CORS adicional)
# Produção: https://curriculoproia.com.br  |  Dev local: http://localhost:4200
FRONTEND_URL=https://curriculoproia.com.br

# Landing page (CORS adicional)
# Produção: https://site.curriculoproia.com.br
LANDING_PAGE_URL=https://site.curriculoproia.com.br

# URL pública da API (obrigatório em produção — webhooks Mercado Pago)
PUBLIC_API_URL=https://api.curriculoproia.com.br

# Swagger em produção (IIS/Plesk): true para /swagger
ENABLE_SWAGGER=true

# Provedor de pagamento padrão (stripe | mercadopago) — pode ser alterado no painel admin
PAYMENT_PROVIDER=stripe

# Stripe (opcional - apenas se quiser usar pagamentos reais)
STRIPE_SECRET_KEY=sk_test_sua-chave-stripe
STRIPE_WEBHOOK_SECRET=whsec_sua-webhook-secret
STRIPE_STATEMENT_DESCRIPTOR=CurriculosPro IA

# Mercado Pago (Checkout Pro)
# Modo: painel admin (preferencial) ou MERCADOPAGO_MODE aqui se admin não estiver definido
# test = sandbox | production = cobrança real (PIX)
MERCADOPAGO_MODE=test

# Teste — Developers → Suas integrações → Credenciais de TESTE → Access Token
MERCADOPAGO_ACCESS_TOKEN_TEST=APP_USR-seu-access-token-teste
MERCADOPAGO_PUBLIC_KEY_TEST=APP_USR-sua-public-key-teste

# Produção — Developers → Credenciais de PRODUÇÃO (token DIFERENTE do de teste!)
MERCADOPAGO_ACCESS_TOKEN_PRODUCTION=APP_USR-seu-access-token-producao
MERCADOPAGO_PUBLIC_KEY_PRODUCTION=APP_USR-sua-public-key-producao
MERCADOPAGO_CLIENT_ID_PRODUCTION=seu-client-id
MERCADOPAGO_CLIENT_SECRET_PRODUCTION=seu-client-secret

# Legado: MERCADOPAGO_SANDBOX=true|false (use MERCADOPAGO_MODE preferencialmente)
# MERCADOPAGO_SANDBOX=true

# Sandbox: e-mail do usuário Comprador de teste (Suas integrações → Contas de teste)
# Ex.: test_user_123456789@testuser.com — use ao pagar com «Entrar com minha conta»
# MERCADOPAGO_TEST_PAYER_EMAIL=test_user_123456789@testuser.com
# URL pública da API para webhooks do Mercado Pago (produção)
# PUBLIC_API_URL=https://api.seudominio.com.br

# Google OAuth (opcional - para login com Google)
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# SerpAPI — vagas do Google Jobs + Indeed/Catho no painel (sem redirecionar o usuário)
# Sem chave: busca Indeed e Catho automaticamente. Com chave: inclui também Google Jobs.
# https://serpapi.com/ (plano gratuito com limite mensal)
SERPAPI_KEY=

# Simli — avatar em vídeo da entrevistadora (https://simli.com)
SIMLI_API_KEY=sua-chave-simli-aqui
SIMLI_FACE_ID=cace3ef7-a4c4-425d-a8cf-a5358eb0c427
SIMLI_FACE_ID_FEMALE=cace3ef7-a4c4-425d-a8cf-a5358eb0c427
SIMLI_FACE_ID_AR=cace3ef7-a4c4-425d-a8cf-a5358eb0c427
SIMLI_TRANSPORT=livekit

# Session Secret (para OAuth)
SESSION_SECRET=seu_secret_key_super_seguro_aqui_mude_em_producao
